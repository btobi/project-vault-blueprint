filters:
  and:
    - '!file.inFolder("templates")'
    - or:
        - 'note.type == link("Report")'
        - 'note.type == "[[Report]]"'
views:
  - type: table
    name: All
    order:
      - file.name
      - date
      - updated
      - status
    sort:
      - property: date
        direction: DESC
